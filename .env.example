# ---------------------------------------------------------------------------
# HNX-CIS Backend — copy to `.env` for local development.
# In production these come from the Cloud Run service config + Secret Manager.
# ---------------------------------------------------------------------------

NODE_ENV="development"
PORT="8080"

# Browser origins allowed to call this API (comma-separated).
# Production example: https://hnxcis-frontend-xxxxxxxx-as.a.run.app
CORS_ORIGINS="http://localhost:5173"

# --- Gemini (Secret Manager: hnxcis-gemini-api-key) -------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.6-flash"

# --- Firebase Auth ----------------------------------------------------------
FIREBASE_PROJECT_ID="dkquoc-sandbox-cob"
# true => every /api/gemini/* call must carry a valid Firebase ID token.
AUTH_REQUIRED="false"

# --- Cloud SQL (Postgres) ---------------------------------------------------
# On Cloud Run set INSTANCE_CONNECTION_NAME and deploy with
#   --add-cloudsql-instances <project:region:instance>
# The app then connects over the Unix socket /cloudsql/<instance>.
INSTANCE_CONNECTION_NAME=""

# Locally, run the Cloud SQL Auth Proxy and keep the TCP settings below:
#   cloud-sql-proxy --port 5432 <project:region:instance>
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_DB_NAME="hnxcis"
SQL_USER="hnxcis_app"
SQL_PASSWORD="MY_DB_PASSWORD"
SQL_SSL="false"
SQL_POOL_MAX="10"

# --- Migrations (drizzle-kit only, never used by the running service) --------
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="MY_DB_ADMIN_PASSWORD"
